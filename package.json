{
  "name": "super-offers-argentina",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Comparador de ofertas de supermercados argentinos (Jumbo, Coto, Disco, Vea, Carrefour, Dia, ChangoMas y Vital)",
  "scripts": {
    "dev": "concurrently -k \"node server/index.mjs\" \"vite\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "server": "node server/index.mjs",
    "server:dev": "node --watch server/index.mjs",
    "dev:all": "concurrently -k \"node server/index.mjs\" \"vite\""
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^0.454.0",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
